# FRAIME LAB experimental image. Does NOT replace the running YSocial deployment.
# Pin upstream release; Python dependencies stay in the immutable image layer.
FROM ghcr.io/ysocialtwin/ysocial:v4.0.0

ARG PHOTO_SHARING_TAG=v2.1.0
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# Install a CPU-only torch/vision pair before YPhotoSharing's dependencies.
# YPhotoSharing's annotation module eagerly imports Detoxify, so keep its
# dependencies, while excluding CUDA runtime downloads via the CPU wheels.
RUN python -m pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      'torch==2.5.1+cpu' 'torchvision==0.20.1+cpu'

RUN git clone --depth 1 --branch "${PHOTO_SHARING_TAG}" \
      https://github.com/YSocialTwin/YPhotoSharing.git /tmp/YPhotoSharing \
    && python -m pip install --no-cache-dir -r /tmp/YPhotoSharing/requirements.txt \
    && mkdir -p /opt/fraime-plugins/YPhotoSharing \
    && cp -a /tmp/YPhotoSharing/. /opt/fraime-plugins/YPhotoSharing/ \
    && rm -rf /tmp/YPhotoSharing \
    && python -c "import torch; assert not torch.cuda.is_available(); print('CPU torch:',torch.__version__)" \
    && python -c "import ray, detoxify; print('Ray and Detoxify imports OK')"

# OpenAI-compatible Beam Pro endpoint support. Apply to the immutable plugin
# copy; the entrypoint applies the same idempotent patch to old /data installs.
RUN python -m pip install --no-cache-dir 'langchain-openai>=0.2,<1.0'
COPY scripts/patch-photo-llm.py /usr/local/bin/fraime-patch-photo-llm.py
RUN python /usr/local/bin/fraime-patch-photo-llm.py /opt/fraime-plugins/YPhotoSharing

# Patch installed upstream YSocial only inside the immutable LAB image.
# Fail image build if pinned upstream code no longer matches expected markers.
COPY scripts/patch-hpc-lifecycle.py /tmp/fraime-patch-hpc-lifecycle.py
RUN python /tmp/fraime-patch-hpc-lifecycle.py && rm /tmp/fraime-patch-hpc-lifecycle.py

COPY scripts/lab-entrypoint.sh /usr/local/bin/fraime-lab-entrypoint
RUN chmod 755 /usr/local/bin/fraime-lab-entrypoint
ENTRYPOINT ["/usr/local/bin/fraime-lab-entrypoint"]
